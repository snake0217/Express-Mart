        <TR><TD ALIGN="LEFT">nombre_producto</TD><TD ALIGN="RIGHT"><FONT COLOR="#718096">TEXT [snapshot]</FONT></TD></TR>
        <TR><TD ALIGN="LEFT">cantidad</TD><TD ALIGN="RIGHT"><FONT COLOR="#718096">INTEGER</FONT></TD></TR>
