        <TR><TD COLSPAN="2" BGCOLOR="#1A365D"><FONT COLOR="#FFFFFF"><B>catalogo (D2)</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>id</B> (PK)</TD><TD ALIGN="RIGHT"><FONT COLOR="#718096">INTEGER</FONT></TD></TR>
