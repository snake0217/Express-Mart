# ExpressMart - Configuración de Ambiente (Apartados 15.2 y 20)
# NUNCA almacenar secretos de producción en el repositorio Git.
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0
DB_PATH=./data/expressmart.sqlite

# Gestor de secretos (en producción inyectado desde Vault / AWS Secrets Manager)
SECRET_ENCRYPTION_KEY=expressmart-dev-32byte-secret-key!
SESSION_SECRET=expressmart-session-hmac-secret-2026
SESSION_TTL_MINUTES=30

# Configuración de Pasarela de Pagos PCI DSS (RFC-0001 / PRB-0001)
PAYMENT_GATEWAY_TIMEOUT_MS=30000
PAYMENT_GATEWAY_MAX_RETRIES=3
PAYMENT_GATEWAY_PROVIDER=Stripe-PCI-DSS-v4.0

# Banderas de funcionalidad (Feature Flags - Apartado 11.1)
FEATURE_THREE_STEP_CHECKOUT=true
FEATURE_RECOMMENDATIONS_SERVICE=true
FEATURE_MFA_ENFORCED_ADMIN=true
