# ExpressMart - Configuración de Ambiente (Apartados 15.2 y 20 - MC-001)
# NUNCA almacenar secretos de producción en el repositorio Git.
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0
DB_PATH=./data/expressmart.sqlite

# Gestor de Secretos Criptográficos (MC-001 §15.2 y §18.2 / Hallazgo H-04)
# Para generar claves seguras de 32 bytes (64 caracteres hex) ejecuta en consola:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# En producción/staging estos valores DEBEN inyectarse mediante Vault o AWS Secrets Manager.
# En desarrollo local puedes definir tus propias claves o usar las provisionales locales.
SECRET_ENCRYPTION_KEY=reemplazar_con_clave_hex_de_32_bytes_para_aes_256_gcm
SESSION_SECRET=reemplazar_con_clave_hex_de_32_bytes_para_firmas_hmac_sesion
SESSION_TTL_MINUTES=30

# Configuración de Pasarela de Pagos PCI DSS (RFC-0001 / PRB-0001)
PAYMENT_GATEWAY_TIMEOUT_MS=30000
PAYMENT_GATEWAY_MAX_RETRIES=3
PAYMENT_GATEWAY_PROVIDER=Stripe-PCI-DSS-v4.0

# Integración Oficial PayPal Sandbox (México - Moneda MXN)
PAYPAL_CLIENT_ID=Ac1DHKE068BKREloy9_v2y2mb5PawyS-0dX32ko2XKrwfYxyejUYXfMjoUaEkRpmloEN6kf3SlgGrdw_
PAYPAL_CLIENT_SECRET=EOywKcH9CQZwi1hQXS8STOKthzBrkJ-BFAgWKCV6wy0MY5lJTq9xwprhuzjfQge4ojp05tRjQ805kEs_
PAYPAL_SANDBOX_EMAIL=bancochido@banco.com
PAYPAL_SANDBOX_PASSWORD=nBBi"*d6
PAYPAL_SANDBOX_URL=https://sandbox.paypal.com
PAYPAL_REGION=MX
PAYPAL_ENVIRONMENT=sandbox

# Banderas de funcionalidad (Feature Flags - Apartado 11.1)
FEATURE_THREE_STEP_CHECKOUT=true
FEATURE_RECOMMENDATIONS_SERVICE=true
FEATURE_MFA_ENFORCED_ADMIN=true

