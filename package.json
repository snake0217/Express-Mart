{
  "name": "expressmart-ecommerce",
  "version": "1.0.0",
  "description": "Plataforma de comercio electrónico ExpressMart - TiendaExpress Online, S.A. de C.V. (SGC MC-001)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --coverage --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest tests/unit.test.js",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest tests/integration.test.js",
    "test:security": "node --experimental-vm-modules node_modules/.bin/jest tests/security.test.js",
    "test:performance": "node scripts/performance-test.js",
    "lint": "node scripts/static-analysis.js",
    "db:verify": "node scripts/verify-db-functional.js",
    "ci:verify": "npm run lint && npm test && npm run test:performance && npm run db:verify && npm run backup && npm run audit:verify",
    "backup": "node scripts/backup-restore.js --backup",
    "restore:verify": "node scripts/backup-restore.js --verify",
    "audit:verify": "node scripts/audit-verifier.js"
  },
  "keywords": [
    "ecommerce",
    "expressmart",
    "iso-25010",
    "iso-27001",
    "pci-dss",
    "owasp-asvs",
    "lfpdppp",
    "lfpc"
  ],
  "author": "Diego Alarcon De Jesus, Carlos Adair Bautista Godinez, Cristopher Erik San Juan Piza",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 70,
        "functions": 90,
        "lines": 85
      }
    }
  }
}
